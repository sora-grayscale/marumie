# ===========================================
# mirai-kojin Environment Configuration
# ===========================================

# --- Database ---
POSTGRES_USER=mirai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mirai_kojin
DATABASE_URL=postgresql://mirai:CHANGE_ME_STRONG_PASSWORD@db:5432/mirai_kojin?sslmode=require
DIRECT_URL=postgresql://mirai:CHANGE_ME_STRONG_PASSWORD@db:5432/mirai_kojin?sslmode=require

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8080
RUST_LOG=info

# --- Encryption ---
ENCRYPTION_SALT=CHANGE_ME_RANDOM_32CHAR_STRING
BACKUP_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64CHAR_STRING

# --- Backup ---
BACKUP_RETENTION_DAYS=30

# --- WebAuthn ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# --- Session ---
SESSION_SECRET=CHANGE_ME_RANDOM_64CHAR_STRING
